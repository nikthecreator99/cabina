# CABINA: Caddy на сервере Селектел (с 03.11.2026). В /opt/cabina/Caddyfile, внутри контейнера — /etc/caddy/Caddyfile.
# Сертификаты HTTPS Caddy получает сам (Let's Encrypt), когда записи A домена указывают на этот сервер.
# Журнал обращений не ведётся: IP-адреса посетителей не записываются.
{
	admin off
}

(secure) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# Свои разрешения CORS у входа и PostgREST убираем: отвечает только Caddy (в api.cabina-app.ru ниже)
(nocors) {
	header_down -Access-Control-Allow-Origin
	header_down -Access-Control-Allow-Credentials
	header_down -Access-Control-Allow-Headers
	header_down -Access-Control-Allow-Methods
	header_down -Access-Control-Expose-Headers
	header_down -Access-Control-Max-Age
}

# Сайт приложения. Файлы выкладывает /usr/local/bin/cabina-site в /opt/cabina/www/current.
cabina-app.ru {
	import secure
	# камера — только для своего сайта: сканировать QR напарника в окне (Android); остальное выключено
	header Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
	root * /srv/www/current
	# страница, service worker и «Что нового» — всегда свежие, чтобы обновление приходило сразу
	@fresh path / /index.html /sw.js /manifest.webmanifest /data/*
	header @fresh Cache-Control "no-cache"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
	encode gzip
	file_server
}

www.cabina-app.ru {
	redir https://cabina-app.ru{uri} permanent
}

# Сервер аккаунтов: наружу только /auth/v1/* и /rest/v1/*, остальное — 404.
api.cabina-app.ru {
	import secure
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

	# Запросы из браузера разрешены только приложению с https://cabina-app.ru
	@ours header Origin https://cabina-app.ru
	header @ours {
		defer
		Access-Control-Allow-Origin "https://cabina-app.ru"
		Vary "Origin"
	}
	@preflight {
		method OPTIONS
		header Origin https://cabina-app.ru
	}
	handle @preflight {
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "apikey, authorization, content-type, x-client-info, prefer, range, accept-profile, content-profile"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	handle_path /auth/v1/* {
		reverse_proxy auth:9999 {
			import nocors
		}
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000 {
			import nocors
		}
	}
	# значок в письмах с кодом
	handle /mail/icon.png {
		root * /srv
		header Cache-Control "public, max-age=604800"
		file_server
	}
	handle {
		respond 404
	}
}

# Письма с кодом для GoTrue — только во внутренней сети Docker (порт 8088 наружу не открыт)
http://:8088 {
	root * /srv/mail
	@tpl path /confirm.html /recovery.html
	handle @tpl {
		file_server
	}
	handle {
		respond 404
	}
}
